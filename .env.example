# ============================================================
# College Command Center — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control.

# --- Supabase (Frontend - these are PUBLIC, safe to expose) ---
# Get from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- AI (Backend Only - NEVER put these in VITE_ variables) ---
# These go into your Supabase Edge Function secrets, NOT here.
# Run: supabase secrets set AI_API_KEY=your-openai-key
# AI_API_KEY=your-openai-api-key
# AI_MODEL=gpt-4o

# --- App Config ---
VITE_APP_NAME=College Command Center
VITE_APP_VERSION=1.0.0
